{
  "expo": {
    "name": "Sidecar for Aside",
    "slug": "sidecar-for-aside",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sidecarforaside",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.theranorth.sidecarforaside",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera scans the pairing code shown on your computer screen.",
        "NSLocalNetworkUsageDescription": "The app talks to the Aside bridge running on your computer over your local network.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "buildNumber": "3",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.theranorth.sidecarforaside",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera scans the pairing code shown on your computer screen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#000000"
        }
      ]
    ],
    "primaryColor": "#000000",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e039d899-6315-472e-a409-a1b3261dcd28"
      }
    },
    "owner": "thera-north"
  }
}
