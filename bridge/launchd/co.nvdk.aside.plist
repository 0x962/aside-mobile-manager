<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.nvdk.aside</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Aside.app/Contents/MacOS/Aside</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/aside-app.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/aside-app.log</string>
</dict>
</plist>
